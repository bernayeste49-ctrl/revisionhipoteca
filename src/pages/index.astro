---
import Base from '../layouts/Base.astro';
import EuriborChart from '../components/EuriborChart.astro';
import { latestYm, value, monthLabel, shiftYm, pct, signed, eur, cuota, raw, months } from '../lib/euribor.js';
import { faqLd } from '../lib/seo.js';

const hoy = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Madrid', year: 'numeric', month: '2-digit' }).format(new Date()).slice(0, 7);
const proximas = Array.from({ length: 13 }, (_, i) => shiftYm(hoy, i));
const defRev = shiftYm(hoy, 1);
const ult = value(latestYm), prev = value(shiftYm(latestYm, -1)), anio = value(shiftYm(latestYm, -12));

// Resultado inicial (mismo cálculo que el script del navegador)
const D = { capital: 150000, anos: 22, dif: 0.75, periodo: 12, lag: 2 };
const idxNew = shiftYm(defRev, -D.lag);
const usaNew = value(idxNew) !== undefined ? idxNew : latestYm;
const idxOld = shiftYm(idxNew, -D.periodo);
const tOld = Math.max(0, value(idxOld) + D.dif), tNew = Math.max(0, value(usaNew) + D.dif);
const cOld = cuota(D.capital, tOld, D.anos * 12), cNew = cuota(D.capital, tNew, D.anos * 12);
const diff = cNew - cOld;

const faqs = [
  ['¿Qué euríbor se usa en la revisión de mi hipoteca?', 'El que diga tu contrato. Lo más habitual es el valor oficial del euríbor a un año de dos meses antes de la fecha de revisión: si tu hipoteca se revisa en diciembre, se usa el de octubre. Ese valor es la media del mes y lo publica el Banco de España en el BOE.'],
  ['¿Cada cuánto se revisa una hipoteca variable?', 'Normalmente cada 12 meses o cada 6 meses. En la revisión semestral el banco compara con el euríbor de seis meses antes, así que los cambios llegan antes, tanto al subir como al bajar.'],
  ['¿Por qué mi cuota no sale exactamente igual que la del banco?', 'Porque el banco usa el capital pendiente y los días exactos de tu préstamo, y puede aplicar redondeos, suelos o bonificaciones del diferencial. Esta calculadora da una estimación muy cercana con los datos que introduces.'],
  ['¿Cuándo se publica el euríbor oficial de cada mes?', 'El Banco de España lo difunde los primeros días del mes siguiente y es oficial cuando aparece en el BOE. Esta web lo actualiza automáticamente en cuanto está disponible.'],
];
const ld = [faqLd(faqs), { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Calculadora de revisión de la hipoteca', url: 'https://revisionhipoteca.es/', applicationCategory: 'FinanceApplication', operatingSystem: 'Web', offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' }, inLanguage: 'es-ES' }];
const ultimos = months.slice(-13).reverse();
---
<Base title={`¿Cuánto subirá mi hipoteca? Calculadora de la revisión con el euríbor de ${monthLabel(latestYm)}`} description={`Calcula tu nueva cuota en la próxima revisión de la hipoteca variable con el euríbor oficial (${pct(ult)} en ${monthLabel(latestYm)}). Gratis, sin registro y en segundos.`} jsonLd={ld}>
  <section slot="hero" class="hero">
    <div class="wrap">
      <p class="kicker"><span class="tag">Calculadora gratuita</span> El euríbor oficial está <strong class={ult - anio >= 0 ? 'up' : 'down'}>{Math.abs(ult - anio).toLocaleString('es-ES', { maximumFractionDigits: 2 })} puntos {ult - anio >= 0 ? 'más alto' : 'más bajo'}</strong> que hace un año</p>
      <h1>¿Cuánto te subirá la hipoteca en la próxima revisión?</h1>
      <p class="lead">Introduce los datos de tu hipoteca variable y calcula al instante tu nueva cuota con el euríbor oficial que aplicará tu banco.</p>

      <div class="panel">
        <form id="rev" class="calc" autocomplete="off">
          <p class="panel-title">Datos de tu hipoteca</p>
          <div class="field"><label for="capital">Capital pendiente</label><div class="inp"><input id="capital" inputmode="numeric" value="150.000" /><span>€</span></div></div>
          <div class="field"><label for="anos">Plazo restante</label><div class="inp"><input id="anos" inputmode="decimal" value="22" /><span>años</span></div></div>
          <div class="field"><label for="dif">Diferencial</label><div class="inp"><input id="dif" inputmode="decimal" value="0,75" /><span>%</span></div></div>
          <div class="field"><label for="periodo">Revisión</label><select id="periodo"><option value="12" selected>Anual</option><option value="6">Semestral</option></select></div>
          <div class="field wide-m"><label for="mes">Próxima revisión</label><select id="mes">{proximas.map((ym) => <option value={ym} selected={ym === defRev}>{monthLabel(ym).replace(/^(\w{3})\w* de /, '$1 ').replace(/^./, (c) => c.toUpperCase())}</option>)}</select></div>
          <div class="field wide-m"><label for="lag">Euríbor aplicado</label><select id="lag"><option value="1">1 mes antes</option><option value="2" selected>2 meses antes</option><option value="3">3 meses antes</option></select></div>
          <p class="calc-hint">El capital pendiente y el diferencial aparecen en tu recibo o en la app de tu banco. La mayoría de contratos usan el euríbor de dos meses antes.</p>
        </form>
        <div class="result" aria-live="polite">
          <p class="r-label">Tu revisión de <span id="r-mes">{monthLabel(defRev)}</span></p>
          <p class="r-diff"><span id="r-diff" class={diff >= 0 ? 'up' : 'down'}>{(diff >= 0 ? '+' : '−') + eur(Math.abs(diff))}</span> <small>al mes</small></p>
          <p class="r-year" id="r-year">{(diff >= 0 ? 'Pagarás ' : 'Ahorrarás ') + eur(Math.abs(diff * D.periodo), 0) + (diff >= 0 ? ' más' : '') + ` en los próximos ${D.periodo} meses`}</p>
          <div class="bars">
            <div class="bar-row"><span>Cuota actual</span><strong id="r-old">{eur(cOld)}</strong></div>
            <div class="bar"><i id="b-old" style={`width:${(Math.min(cOld, cNew) / Math.max(cOld, cNew)) * 100 * (cOld <= cNew ? 1 : 1)}%`}></i></div>
            <div class="bar-row"><span>Cuota nueva</span><strong id="r-new">{eur(cNew)}</strong></div>
            <div class="bar new"><i id="b-new" style={`width:${(cNew / Math.max(cOld, cNew)) * 100}%`}></i></div>
          </div>
          <p class="r-idx" id="r-idx">Euríbor de {monthLabel(idxOld)}: {pct(value(idxOld))} → {monthLabel(usaNew)}: {pct(value(usaNew))}</p>
          <p class="r-note" id="r-note" hidden={usaNew === idxNew}>El euríbor de {monthLabel(idxNew)} aún no se ha publicado: usamos el último oficial ({monthLabel(latestYm)}).</p>
          <p class="r-how">Estimación orientativa · <a href="/guias/como-funciona-revision-hipoteca/">Cómo se calcula</a></p>
        </div>
      </div>
      <ul class="trust">
        <li>Euríbor oficial del Banco de España</li>
        <li>Gratis y sin registro</li>
        <li>Tus datos no salen de tu navegador</li>
      </ul>
    </div>
  </section>

  <section class="block">
    <div class="block-head">
      <h2>El euríbor oficial, mes a mes</h2>
      <p>La media mensual del euríbor a un año que publica el Banco de España en el BOE: el valor que usan los bancos en la revisión.</p>
    </div>
    <div class="kpis">
      <div class="kpi"><span class="k">{monthLabel(latestYm).replace(/^./, (c) => c.toUpperCase())}</span><span class="v">{pct(ult)}</span><span class="s">Último dato oficial</span></div>
      <div class="kpi"><span class="k">Frente al mes anterior</span><span class={`v ${ult - prev >= 0 ? 'up' : 'down'}`}>{signed(ult - prev)}</span><span class="s">puntos</span></div>
      <div class="kpi"><span class="k">Frente a hace un año</span><span class={`v ${ult - anio >= 0 ? 'up' : 'down'}`}>{signed(ult - anio)}</span><span class="s">puntos</span></div>
    </div>
    <div class="card chart-card">
      <EuriborChart n={24} caption="Euríbor a un año, valor oficial mensual de los últimos 24 meses. Fuente: Banco de España." />
    </div>
    <div class="card table-card table-scroll">
      <table class="hist">
        <thead><tr><th>Mes</th><th class="num">Euríbor a 1 año</th><th class="num">Mes anterior</th><th class="num">Hace un año</th></tr></thead>
        <tbody>
          {ultimos.slice(0, 6).map((ym) => { const v = value(ym), p = value(shiftYm(ym, -1)), a = value(shiftYm(ym, -12)); return (
            <tr><td>{monthLabel(ym).replace(/^./, (c) => c.toUpperCase())}</td><td class="num"><strong>{pct(v)}</strong></td><td class={`num ${v - p >= 0 ? 'up' : 'down'}`}>{signed(v - p)}</td><td class={`num ${v - a >= 0 ? 'up' : 'down'}`}>{a !== undefined ? signed(v - a) : '—'}</td></tr>
          ); })}
        </tbody>
      </table>
      <a class="more" href="/euribor/">Ver todos los meses desde 1999</a>
    </div>
  </section>

  <section class="block">
    <div class="block-head">
      <h2>Cómo calcula tu banco la nueva cuota</h2>
      <p>Tres pasos, siempre los mismos. Si los conoces, puedes comprobar la carta de tu banco.</p>
    </div>
    <ol class="steps">
      <li><h3>Toma el índice</h3><p>El euríbor oficial a un año del mes que fija tu contrato, normalmente dos meses antes de la revisión.</p></li>
      <li><h3>Suma tu diferencial</h3><p>Con un euríbor del {pct(ult)} y un diferencial del 0,75 %, el nuevo tipo es del {pct(ult + 0.75)}.</p></li>
      <li><h3>Recalcula la cuota</h3><p>Con el capital y los meses que te quedan, por el sistema francés. La cuota se mantiene hasta la siguiente revisión.</p></li>
    </ol>
    <p class="aside">Si tu contrato tiene cláusula suelo o bonificaciones, el tipo puede ser distinto. Más detalles en <a href="/guias/como-funciona-revision-hipoteca/">cómo funciona la revisión de la hipoteca</a>.</p>
  </section>

  <section class="block">
    <div class="block-head">
      <h2>Si la cuota te sube demasiado</h2>
      <p>Tres salidas habituales, cada una con su calculadora o su guía.</p>
    </div>
    <div class="options">
      <a class="option" href="/guias/diferencial-hipoteca/"><h3>Revisa tu diferencial</h3><p>Las bonificaciones por nómina o seguros pueden rebajarlo. Aprende a saber si te compensan.</p><span>Leer la guía</span></a>
      <a class="option" href="/amortizar-hipoteca/"><h3>Amortiza reduciendo cuota</h3><p>Adelantar dinero baja la cuota desde el mes siguiente. Calcula cuánto te ahorras.</p><span>Abrir la calculadora</span></a>
      <a class="option" href="/fijo-o-variable/"><h3>Valora pasar a fijo</h3><p>Renuncias a una posible bajada a cambio de una cuota estable. Compara las dos opciones.</p><span>Comparar fijo y variable</span></a>
    </div>
  </section>

  <section class="block">
    <div class="block-head"><h2>Preguntas frecuentes</h2></div>
    {faqs.map(([q, a]) => (<details><summary>{q}</summary><p>{a}</p></details>))}
  </section>
</Base>

<script is:inline type="application/json" id="eur-data" set:html={JSON.stringify(raw)}></script>
<script>
  const E: Record<string, number> = JSON.parse(document.getElementById('eur-data')!.textContent!);
  const MESES = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
  const keys = Object.keys(E).sort(); const latest = keys[keys.length - 1];
  const label = (ym: string) => { const [y, m] = ym.split('-'); return `${MESES[+m - 1]} de ${y}`; };
  const shift = (ym: string, n: number) => { const [y, m] = ym.split('-').map(Number); return new Date(Date.UTC(y, m - 1 + n, 1)).toISOString().slice(0, 7); };
  const num = (s: string) => parseFloat(s.replace(/\./g, '').replace(',', '.'));
  const eur = (v: number, d = 2) => v.toLocaleString('es-ES', { minimumFractionDigits: d, maximumFractionDigits: d }) + ' €';
  const pct = (v: number) => v.toLocaleString('es-ES', { minimumFractionDigits: 3, maximumFractionDigits: 3 }) + ' %';
  const cuota = (P: number, t: number, n: number) => { const r = t / 100 / 12; return r === 0 ? P / n : (P * r) / (1 - Math.pow(1 + r, -n)); };
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const capital = $('capital');
  capital.addEventListener('blur', () => { const v = num(capital.value); if (v > 0) capital.value = Math.round(v).toLocaleString('es-ES'); });
  function calc() {
    const P = num(capital.value), anos = num($('anos').value), dif = num($('dif').value);
    const periodo = +$('periodo').value, lag = +$('lag').value, mes = $('mes').value;
    if (!(P > 0) || !(anos > 0) || Number.isNaN(dif)) return;
    const idxNew = shift(mes, -lag); const usa = E[idxNew] !== undefined ? idxNew : latest; const idxOld = shift(idxNew, -periodo);
    if (E[idxOld] === undefined) return;
    const n = Math.round(anos * 12);
    const cO = cuota(P, Math.max(0, E[idxOld] + dif), n), cN = cuota(P, Math.max(0, E[usa] + dif), n), d = cN - cO;
    $('r-mes').textContent = label(mes);
    $('r-old').textContent = eur(cO); $('r-new').textContent = eur(cN);
    const mx = Math.max(cO, cN); ($('b-old') as any).style.width = (cO / mx) * 100 + '%'; ($('b-new') as any).style.width = (cN / mx) * 100 + '%';
    const rd = $('r-diff'); rd.textContent = (d >= 0 ? '+' : '−') + eur(Math.abs(d)); rd.className = d >= 0 ? 'up' : 'down';
    $('r-year').textContent = (d >= 0 ? 'Pagarás ' : 'Ahorrarás ') + eur(Math.abs(d * periodo), 0) + (d >= 0 ? ' más' : '') + ` en los próximos ${periodo} meses`;
    $('r-idx').textContent = `Euríbor de ${label(idxOld)}: ${pct(E[idxOld])} → ${label(usa)}: ${pct(E[usa])}`;
    const note = $('r-note'); note.hidden = usa === idxNew;
    note.textContent = `El euríbor de ${label(idxNew)} aún no se ha publicado: usamos el último oficial (${label(latest)}).`;
  }
  document.getElementById('rev')!.addEventListener('input', calc);
  document.getElementById('rev')!.addEventListener('change', calc);
</script>

<style>
  .hero { background: var(--canvas); border-bottom: 1px solid var(--line); padding: 52px 0 40px; }
  .kicker { font-size: 0.92rem; color: var(--muted); margin-bottom: 18px; display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .tag { background: #fff; border: 1px solid var(--line); color: var(--ink); font-weight: 600; font-size: 0.8rem; padding: 4px 10px; border-radius: 999px; }
  .hero h1 { max-width: 19ch; }
  .hero .lead { margin-bottom: 30px; }
  .panel { display: grid; grid-template-columns: 1.4fr 1fr; background: #fff; border: 1px solid var(--line); border-radius: 22px; box-shadow: 0 30px 60px -40px rgba(17, 24, 51, 0.45); overflow: hidden; }
  .calc { display: grid; grid-template-columns: repeat(6, 1fr); gap: 18px 16px; padding: 28px; align-content: start; }
  .calc > .field { grid-column: span 2; }
  .panel-title { grid-column: 1 / -1; margin: 0; font-family: var(--display); font-weight: 700; font-size: 1.1rem; }
  .calc select { padding-left: 12px; padding-right: 30px; background-position: calc(100% - 16px) 21px, calc(100% - 11px) 21px; }
  .calc-hint { grid-column: 1 / -1; margin: 2px 0 0; font-size: 0.82rem; color: var(--muted); }
  .result { background: var(--ink); color: #fff; padding: 28px 30px; display: flex; flex-direction: column; }
  .r-label { color: #aeb5cf; margin: 0 0 6px; font-size: 0.95rem; }
  .r-diff { margin: 0; font-family: var(--display); font-size: clamp(2.8rem, 5.6vw, 4rem); font-weight: 800; line-height: 1; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
  .r-diff .up { color: #ff8a8f; } .r-diff .down { color: #5fe3a8; }
  .r-diff small { font-family: var(--font); font-size: 1rem; font-weight: 500; color: #aeb5cf; letter-spacing: 0; }
  .r-year { margin: 10px 0 22px; font-weight: 600; }
  .bars { display: grid; gap: 6px; margin-bottom: 20px; }
  .bar-row { display: flex; justify-content: space-between; font-size: 0.9rem; color: #c7cce0; margin-top: 6px; }
  .bar-row strong { color: #fff; font-variant-numeric: tabular-nums; }
  .bar { height: 8px; background: #252d52; border-radius: 99px; overflow: hidden; }
  .bar i { display: block; height: 100%; background: #6f7aa8; border-radius: 99px; transition: width 0.25s ease; }
  .bar.new i { background: var(--coral); }
  .r-idx { font-size: 0.85rem; color: #aeb5cf; margin: auto 0 4px; padding-top: 14px; border-top: 1px solid #2a3358; }
  .r-note { font-size: 0.8rem; color: #aeb5cf; margin: 0 0 4px; }
  .r-note[hidden] { display: none; }
  .r-how { font-size: 0.8rem; color: #8f97b8; margin: 0; }
  .r-how a { color: #c7cce0; }
  .trust { list-style: none; padding: 0; margin: 20px 0 0; display: flex; flex-wrap: wrap; gap: 8px 26px; font-size: 0.9rem; color: #2c3350; }
  .trust li::before { content: ''; display: inline-block; width: 12px; height: 7px; border-left: 2px solid var(--down); border-bottom: 2px solid var(--down); transform: rotate(-45deg) translateY(-3px); margin-right: 10px; }
  .block { margin-top: 72px; }
  .block:first-child { margin-top: 24px; }
  .block-head { margin-bottom: 22px; max-width: 64ch; }
  .block-head h2 { margin: 0 0 6px; }
  .block-head p { color: var(--muted); margin: 0; }
  .kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-bottom: 14px; }
  .kpi { border: 1px solid var(--line); border-radius: 16px; padding: 18px 20px; display: grid; gap: 2px; }
  .kpi .k { font-size: 0.85rem; color: var(--muted); }
  .kpi .v { font-family: var(--display); font-size: 2rem; font-weight: 750; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .kpi .s { font-size: 0.8rem; color: var(--muted); }
  .card { border: 1px solid var(--line); border-radius: 16px; padding: 20px 22px; margin-bottom: 14px; }
  .table-card { padding: 6px 22px 16px; }
  .table-card table { min-width: 480px; }
  .more { display: inline-block; margin-top: 12px; font-weight: 600; text-decoration: none; }
  .more::after { content: ' ›'; }
  .steps { list-style: none; counter-reset: s; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .steps li { counter-increment: s; border: 1px solid var(--line); border-radius: 16px; padding: 20px 22px; }
  .steps li::before { content: counter(s); display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--ink); color: #fff; font-weight: 700; font-size: 0.9rem; margin-bottom: 12px; }
  .steps h3 { margin: 0 0 6px; }
  .steps p { margin: 0; color: #3a4160; font-size: 0.96rem; }
  .aside { color: var(--muted); font-size: 0.92rem; margin-top: 14px; }
  .options { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .option { display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: 16px; padding: 22px; color: var(--ink); text-decoration: none; transition: border-color 0.15s, box-shadow 0.15s; }
  .option:hover { border-color: var(--ink); box-shadow: 0 10px 24px -18px rgba(17, 24, 51, 0.5); color: var(--ink); }
  .option h3 { margin: 0 0 6px; }
  .option p { color: #3a4160; font-size: 0.96rem; flex: 1; }
  .option span { font-weight: 650; color: var(--accent); font-size: 0.92rem; }
  .option span::after { content: ' ›'; }
  @media (max-width: 960px) {
    .panel { grid-template-columns: 1fr; }
    .calc { padding: 22px; }
    .steps, .options { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .hero { padding: 32px 0 28px; }
    .calc { grid-template-columns: 1fr 1fr; gap: 14px 12px; }
    .calc > .field { grid-column: span 1; }
    .calc > .field.wide-m { grid-column: 1 / -1; }
    .result { padding: 24px 22px; }
    .kpis { grid-template-columns: 1fr; }
    .kpi .v { font-size: 1.7rem; }
  }
</style>
