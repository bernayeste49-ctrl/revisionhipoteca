---
import Base from '../layouts/Base.astro';
import EuriborChart from '../components/EuriborChart.astro';
import { latestYm, value, monthLabel, shiftYm, pct, signed, eur, cuota, raw, months } from '../lib/euribor.js';
import { faqLd } from '../lib/seo.js';

const hoy = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Madrid', year: 'numeric', month: '2-digit' }).format(new Date()).slice(0, 7);
const proximas = Array.from({ length: 13 }, (_, i) => shiftYm(hoy, i));
const defRev = shiftYm(hoy, 1);
const ult = value(latestYm), prev = value(shiftYm(latestYm, -1)), anio = value(shiftYm(latestYm, -12));

// Resultado inicial (mismo cálculo que el script del navegador)
const D = { capital: 150000, anos: 22, dif: 0.75, periodo: 12, lag: 2 };
const idxNew = shiftYm(defRev, -D.lag);
const usaNew = value(idxNew) !== undefined ? idxNew : latestYm;
const idxOld = shiftYm(idxNew, -D.periodo);
const tOld = Math.max(0, value(idxOld) + D.dif), tNew = Math.max(0, value(usaNew) + D.dif);
const cOld = cuota(D.capital, tOld, D.anos * 12), cNew = cuota(D.capital, tNew, D.anos * 12);
const diff = cNew - cOld;

const faqs = [
  ['¿Qué euríbor se usa en la revisión de mi hipoteca?', 'El que diga tu contrato. Lo más habitual es el valor oficial del euríbor a un año de dos meses antes de la fecha de revisión: si tu hipoteca se revisa en diciembre, se usa el de octubre. Ese valor es la media del mes y lo publica el Banco de España en el BOE.'],
  ['¿Cada cuánto se revisa una hipoteca variable?', 'Normalmente cada 12 meses o cada 6 meses. En la revisión semestral el banco compara con el euríbor de seis meses antes, así que los cambios llegan antes, tanto al subir como al bajar.'],
  ['¿Por qué mi cuota no sale exactamente igual que la del banco?', 'Porque el banco usa el capital pendiente y los días exactos de tu préstamo, y puede aplicar redondeos, suelos o bonificaciones del diferencial. Esta calculadora da una estimación muy cercana con los datos que introduces.'],
  ['¿Cuándo se publica el euríbor oficial de cada mes?', 'El Banco de España lo difunde los primeros días del mes siguiente y es oficial cuando aparece en el BOE. Esta web lo actualiza automáticamente en cuanto está disponible.'],
];
const ld = [faqLd(faqs), { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Calculadora de revisión de la hipoteca', url: 'https://revisionhipoteca.es/', applicationCategory: 'FinanceApplication', operatingSystem: 'Web', offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' }, inLanguage: 'es-ES' }];
const ultimos = months.slice(-13).reverse();
---
<Base title={`¿Cuánto subirá mi hipoteca? Calculadora de la revisión con el euríbor de ${monthLabel(latestYm)}`} description={`Calcula tu nueva cuota en la próxima revisión de la hipoteca variable con el euríbor oficial (${pct(ult)} en ${monthLabel(latestYm)}). Gratis, sin registro y en segundos.`} jsonLd={ld}>
  <section slot="hero" class="hero">
    <div class="wrap hero-grid">
      <div class="intro">
        <p class="kicker">Calculadora de la revisión · <span class={ult - anio >= 0 ? 'up' : 'down'}>El euríbor está {Math.abs(ult - anio).toLocaleString('es-ES', { maximumFractionDigits: 2 })} puntos {ult - anio >= 0 ? 'más alto' : 'más bajo'} que hace un año</span></p>
        <h1>¿Cuánto te subirá la hipoteca en la próxima revisión?</h1>
        <p class="lead">Pon los datos de tu hipoteca variable y te decimos la cuota nueva con el euríbor oficial que usará tu banco.</p>
      </div>
        <form id="rev" class="calc" autocomplete="off">
          <div class="field"><label for="capital">Capital que te queda por pagar</label><input id="capital" inputmode="numeric" value="150.000" /><span class="hint">En euros. Lo ves en el recibo o en la app del banco.</span></div>
          <div class="field"><label for="anos">Años que te quedan</label><input id="anos" inputmode="decimal" value="22" /></div>
          <div class="field"><label for="dif">Diferencial</label><input id="dif" inputmode="decimal" value="0,75" /><span class="hint">El «euríbor + X %» de tu contrato.</span></div>
          <div class="field"><label for="periodo">Tu hipoteca se revisa</label><select id="periodo"><option value="12" selected>Cada año</option><option value="6">Cada 6 meses</option></select></div>
          <div class="field"><label for="mes">Mes de la próxima revisión</label><select id="mes">{proximas.map((ym) => <option value={ym} selected={ym === defRev}>{monthLabel(ym)}</option>)}</select></div>
          <div class="field"><label for="lag">Euríbor que aplica tu banco</label><select id="lag"><option value="1">El de 1 mes antes</option><option value="2" selected>El de 2 meses antes (lo más habitual)</option><option value="3">El de 3 meses antes</option></select></div>
        </form>
        <ul class="trust">
          <li>Euríbor oficial del Banco de España</li>
          <li>Gratis y sin registro</li>
          <li>Tus datos no salen de tu navegador</li>
        </ul>
      <div class="ticket" aria-live="polite">
        <p class="t-head">Tu revisión de <span id="r-mes">{monthLabel(defRev)}</span></p>
        <dl>
          <div><dt>Cuota hasta ahora</dt><dd id="r-old">{eur(cOld)}</dd></div>
          <div><dt>Cuota nueva</dt><dd id="r-new">{eur(cNew)}</dd></div>
        </dl>
        <p class="t-diff"><span id="r-diff" class={diff >= 0 ? 'up' : 'down'}>{(diff >= 0 ? '+' : '−') + eur(Math.abs(diff))}</span><small>al mes</small></p>
        <p class="t-year" id="r-year">{(diff >= 0 ? 'Pagarás ' : 'Ahorrarás ') + eur(Math.abs(diff * D.periodo), 0) + (diff >= 0 ? ' más' : '') + ` en los próximos ${D.periodo} meses`}</p>
        <hr />
        <p class="t-idx" id="r-idx">Euríbor de {monthLabel(idxOld)}: {pct(value(idxOld))} → {monthLabel(usaNew)}: {pct(value(usaNew))}</p>
        <p class="t-how"><a href="/guias/como-funciona-revision-hipoteca/">Cómo se calcula</a> · Estimación orientativa</p>
        <p class="t-note" id="r-note" hidden={usaNew === idxNew}>El euríbor de {monthLabel(idxNew)} aún no se ha publicado: usamos el último oficial ({monthLabel(latestYm)}).</p>
      </div>
    </div>
  </section>

  <section>
    <h2>El euríbor oficial de los últimos meses</h2>
    <p>Es la media mensual del euríbor a un año que publica el Banco de España en el BOE como tipo de referencia oficial del mercado hipotecario. En {monthLabel(latestYm)} quedó en <strong>{pct(ult)}</strong>, {signed(ult - prev)} puntos respecto al mes anterior y {signed(ult - anio)} respecto a hace un año.</p>
    <EuriborChart n={24} caption="Euríbor a un año, valor oficial mensual. Fuente: Banco de España." />
    <div class="table-scroll">
      <table class="hist">
        <thead><tr><th>Mes</th><th class="num">Euríbor a 1 año</th><th class="num">Frente al mes anterior</th><th class="num">Frente a hace un año</th></tr></thead>
        <tbody>
          {ultimos.map((ym) => { const v = value(ym), p = value(shiftYm(ym, -1)), a = value(shiftYm(ym, -12)); return (
            <tr><td><a href={`/euribor/${ym.slice(0, 4)}/`}>{monthLabel(ym).replace(/^./, (c) => c.toUpperCase())}</a></td><td class="num"><strong>{pct(v)}</strong></td><td class={`num ${v - p >= 0 ? 'up' : 'down'}`}>{signed(v - p)}</td><td class={`num ${v - a >= 0 ? 'up' : 'down'}`}>{a !== undefined ? signed(v - a) : '—'}</td></tr>
          ); })}
        </tbody>
      </table>
    </div>
    <p><a href="/euribor/">Ver el euríbor oficial de todos los meses desde 1999</a></p>
  </section>

  <section class="prose">
    <h2>Cómo calcula tu banco la nueva cuota</h2>
    <ol>
      <li><strong>Busca el índice de referencia.</strong> Casi siempre es el euríbor oficial a un año de un mes concreto, normalmente dos meses antes de la revisión.</li>
      <li><strong>Le suma tu diferencial.</strong> Si el euríbor es 3,239 % y tu diferencial 0,75 %, tu nuevo tipo es 3,989 %.</li>
      <li><strong>Recalcula la cuota</strong> con el capital que te queda y los meses pendientes, con el sistema francés: cuota constante hasta la siguiente revisión.</li>
    </ol>
    <p>Si tu contrato tiene <strong>cláusula suelo</strong> o bonificaciones por nómina y seguros, el tipo puede ser distinto. Lo explicamos en <a href="/guias/como-funciona-revision-hipoteca/">cómo funciona la revisión de la hipoteca</a>.</p>
  </section>

  <section>
    <h2>Si la cuota te sube demasiado</h2>
    <div class="steps">
      <div><h3>Revisa tu diferencial</h3><p>Las bonificaciones por nómina o seguros pueden rebajarlo. A veces compensa, a veces no: <a href="/guias/diferencial-hipoteca/">cómo saberlo</a>.</p></div>
      <div><h3>Amortiza reduciendo cuota</h3><p>Si tienes ahorros, adelantar dinero baja la cuota desde el mes siguiente. <a href="/amortizar-hipoteca/">Calcula cuánto</a>.</p></div>
      <div><h3>Valora pasar a fijo</h3><p>Pierdes la posible bajada del euríbor, pero ganas una cuota estable. <a href="/fijo-o-variable/">Compara las dos</a>.</p></div>
    </div>
  </section>

  <section>
    <h2>Otras calculadoras</h2>
    <ul class="linklist">
      <li><a href="/calculadora-cuota-hipoteca/">Calculadora de cuota<span>Lo que pagarás al mes y en intereses.</span></a></li>
      <li><a href="/fijo-o-variable/">¿Fijo o variable?<span>Compara lo que pagarías con cada uno.</span></a></li>
      <li><a href="/amortizar-hipoteca/">Amortizar: cuota o plazo<span>Cuánto ahorras con cada opción.</span></a></li>
    </ul>
  </section>

  <section>
    <h2>Preguntas frecuentes</h2>
    {faqs.map(([q, a]) => (<details><summary>{q}</summary><p>{a}</p></details>))}
  </section>
</Base>

<script is:inline type="application/json" id="eur-data" set:html={JSON.stringify(raw)}></script>
<script>
  const E: Record<string, number> = JSON.parse(document.getElementById('eur-data')!.textContent!);
  const MESES = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
  const keys = Object.keys(E).sort(); const latest = keys[keys.length - 1];
  const label = (ym: string) => { const [y, m] = ym.split('-'); return `${MESES[+m - 1]} de ${y}`; };
  const shift = (ym: string, n: number) => { const [y, m] = ym.split('-').map(Number); return new Date(Date.UTC(y, m - 1 + n, 1)).toISOString().slice(0, 7); };
  const num = (s: string) => parseFloat(s.replace(/\./g, '').replace(',', '.'));
  const eur = (v: number, d = 2) => v.toLocaleString('es-ES', { minimumFractionDigits: d, maximumFractionDigits: d }) + ' €';
  const pct = (v: number) => v.toLocaleString('es-ES', { minimumFractionDigits: 3, maximumFractionDigits: 3 }) + ' %';
  const cuota = (P: number, t: number, n: number) => { const r = t / 100 / 12; return r === 0 ? P / n : (P * r) / (1 - Math.pow(1 + r, -n)); };
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const capital = $('capital');
  capital.addEventListener('blur', () => { const v = num(capital.value); if (v > 0) capital.value = Math.round(v).toLocaleString('es-ES'); });
  function calc() {
    const P = num(capital.value), anos = num($('anos').value), dif = num($('dif').value);
    const periodo = +$('periodo').value, lag = +$('lag').value, mes = $('mes').value;
    if (!(P > 0) || !(anos > 0) || Number.isNaN(dif)) return;
    const idxNew = shift(mes, -lag); const usa = E[idxNew] !== undefined ? idxNew : latest; const idxOld = shift(idxNew, -periodo);
    if (E[idxOld] === undefined) return;
    const n = Math.round(anos * 12);
    const cO = cuota(P, Math.max(0, E[idxOld] + dif), n), cN = cuota(P, Math.max(0, E[usa] + dif), n), d = cN - cO;
    $('r-mes').textContent = label(mes);
    $('r-old').textContent = eur(cO); $('r-new').textContent = eur(cN);
    const rd = $('r-diff'); rd.textContent = (d >= 0 ? '+' : '−') + eur(Math.abs(d)); rd.className = d >= 0 ? 'up' : 'down';
    $('r-year').textContent = (d >= 0 ? 'Pagarás ' : 'Ahorrarás ') + eur(Math.abs(d * periodo), 0) + (d >= 0 ? ' más' : '') + ` en los próximos ${periodo} meses`;
    $('r-idx').textContent = `Euríbor de ${label(idxOld)}: ${pct(E[idxOld])} → ${label(usa)}: ${pct(E[usa])}`;
    const note = $('r-note'); note.hidden = usa === idxNew;
    note.textContent = `El euríbor de ${label(idxNew)} aún no se ha publicado: usamos el último oficial (${label(latest)}).`;
  }
  document.getElementById('rev')!.addEventListener('input', calc);
  document.getElementById('rev')!.addEventListener('change', calc);
</script>

<style>
  .hero { background: var(--mist); border-bottom: 1px solid var(--line); }
  .hero-grid { display: grid; grid-template-columns: 1.15fr 0.85fr; grid-template-areas: 'intro ticket' 'form ticket' 'trust ticket'; column-gap: 48px; row-gap: 0; padding-top: 44px; padding-bottom: 52px; align-items: start; }
  .kicker { font-size: 0.95rem; margin-bottom: 14px; }
  .intro { grid-area: intro; } .ticket { grid-area: ticket; } .trust { grid-area: trust; list-style: none; padding: 0; margin: 22px 0 0; display: flex; flex-wrap: wrap; gap: 8px 22px; font-size: 0.9rem; color: #2c3350; }
  .trust li::before { content: ''; display: inline-block; width: 14px; height: 8px; border-left: 2.5px solid var(--down); border-bottom: 2.5px solid var(--down); transform: rotate(-45deg) translateY(-3px); margin-right: 9px; }
  .t-how { font-size: 0.82rem; color: var(--muted); margin: 8px 0 0; }
  .t-how a { color: var(--muted); } .calc { grid-area: form; align-items: start; display: grid; grid-template-columns: 1fr 1fr; gap: 16px 18px; margin-top: 22px; }
  .ticket { background: #fff; border-radius: 18px; padding: 26px 26px 20px; box-shadow: 0 1px 0 var(--line), 0 18px 40px -24px rgba(20, 26, 51, 0.45); position: sticky; top: 86px;
    background-image: radial-gradient(circle at 0 50%, var(--mist) 10px, transparent 11px), radial-gradient(circle at 100% 50%, var(--mist) 10px, transparent 11px); }
  .t-head { font-weight: 700; margin-bottom: 14px; }
  .ticket dl { margin: 0; display: grid; gap: 8px; }
  .ticket dl div { display: flex; justify-content: space-between; align-items: baseline; border-bottom: 1px dashed var(--line); padding-bottom: 8px; }
  .ticket dt { color: var(--muted); }
  .ticket dd { margin: 0; font-weight: 650; font-variant-numeric: tabular-nums; font-size: 1.1rem; }
  .t-diff { margin: 18px 0 2px; font-size: clamp(2.6rem, 6vw, 3.6rem); font-weight: 800; line-height: 1; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; font-variation-settings: 'opsz' 96; }
  .t-diff small { font-size: 1rem; font-weight: 500; color: var(--muted); margin-left: 8px; letter-spacing: 0; }
  .t-year { font-weight: 600; margin-bottom: 12px; }
  .ticket hr { border: 0; border-top: 1px dashed var(--line); margin: 12px 0; }
  .t-idx { font-size: 0.88rem; color: var(--muted); margin: 0; }
  .t-note { font-size: 0.82rem; color: var(--muted); margin: 6px 0 0; }
  .t-note[hidden] { display: none; }
  .hist td a { color: var(--ink); }
  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
  .steps h3 { margin-top: 0; }
  .steps p { color: #2c3350; margin: 0; }
  @media (max-width: 760px) { .steps { grid-template-columns: 1fr; gap: 18px; } }
  .small { font-size: 0.85rem; margin-top: 32px; }
  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; grid-template-areas: 'intro' 'ticket' 'form' 'trust'; row-gap: 22px; padding-top: 28px; }
    .calc { margin-top: 0; }
    .ticket { position: static; }
  }
  @media (max-width: 520px) { .calc { grid-template-columns: 1fr; } }
</style>
