---
interface Props { updated: string; sources?: [string, string][] }
const { updated, sources = [] } = Astro.props;
const d = new Date(updated + 'T12:00:00Z').toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
---
<p class="muted byline">Por <a href="/sobre-nosotros/">Bernat Yeste</a> · Actualizado el {d}</p>
<slot />
{sources.length > 0 && (
  <section class="sources">
    <h2>Fuentes</h2>
    <ul>{sources.map(([t, u]) => <li><a href={u} rel="nofollow noopener" target="_blank">{t}</a></li>)}</ul>
  </section>
)}
<style>
  .byline { margin-top: -8px; }
  .sources li { font-size: 0.9rem; }
</style>
