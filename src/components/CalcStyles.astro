  .calc-form .full { grid-column: 1 / -1; }
  .res { border: 1px solid var(--line); border-radius: 16px; padding: 22px; }
  .res .big { font-size: clamp(2.2rem, 5vw, 3rem); font-weight: 800; letter-spacing: -0.02em; line-height: 1.05; font-variant-numeric: tabular-nums; margin: 4px 0 6px; }
