---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/public-sans';
import meta from '../data/meta.json';
import { value, monthLabel, pct } from '../lib/euribor.js';
const fechaBOE = meta.fechaBOE ? new Date(meta.fechaBOE + 'T12:00:00Z').toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' }) : null;
interface Props { title: string; description: string; jsonLd?: object | object[]; noindex?: boolean }
const { title, description, jsonLd, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const lds = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const path = Astro.url.pathname;
const nav = [
  ['/', 'Revisión'],
  ['/calculadora-cuota-hipoteca/', 'Cuota'],
  ['/fijo-o-variable/', 'Fijo o variable'],
  ['/amortizar-hipoteca/', 'Amortizar'],
  ['/euribor/', 'Euríbor'],
  ['/guias/', 'Guías'],
];
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#141a33" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Revisión Hipoteca" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://revisionhipoteca.es/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    {lds.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <div class="wrap hbar">
        <a class="brand" href="/" aria-label="Revisión Hipoteca, inicio">
          <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true"><rect width="32" height="32" rx="7" fill="#141a33"/><path d="M8 21.5 14 15l4 4 6-7.5" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/><circle cx="24" cy="11.5" r="2.6" fill="#ff5a5f"/></svg>
          <span>Revisión<b>Hipoteca</b></span>
        </a>
        <nav aria-label="Principal">
          {nav.map(([href, label]) => <a href={href} aria-current={(href === '/' ? path === '/' : path.startsWith(href)) ? 'page' : undefined}>{label}</a>)}
        </nav>
      </div>
    </header>
    <div class="databar">
      <div class="wrap databar-in">
        <span><span class="live" aria-hidden="true"></span>Euríbor oficial de {monthLabel(meta.ultimoMes)}: <strong>{pct(value(meta.ultimoMes))}</strong></span>
        <span class="databar-src">{fechaBOE ? `Publicado en el BOE el ${fechaBOE}` : 'Fuente: Banco de España'} · <a href="/metodologia/">Fuente y método</a></span>
      </div>
    </div>
    <slot name="hero" />
    <main class="wrap" id="contenido">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap foot">
        <div>
          <p class="foot-brand">Revisión<b>Hipoteca</b></p>
          <p>Calculadoras de hipoteca gratuitas con el euríbor oficial que publica el Banco de España en el BOE.</p>
          <p class="foot-mail"><a href="mailto:hola@revisionhipoteca.es">hola@revisionhipoteca.es</a></p>
        </div>
        <div>
          <p class="foot-title">Calculadoras</p>
          <a href="/">Revisión de la hipoteca</a>
          <a href="/calculadora-cuota-hipoteca/">Cuota de la hipoteca</a>
          <a href="/fijo-o-variable/">Fijo o variable</a>
          <a href="/amortizar-hipoteca/">Amortizar: cuota o plazo</a>
        </div>
        <div>
          <p class="foot-title">Euríbor</p>
          <a href="/euribor/">Euríbor oficial mes a mes</a>
          <a href={`/euribor/${year}/`}>Euríbor {year}</a>
          <a href="/guias/">Guías</a>
        </div>
        <div>
          <p class="foot-title">Revisión Hipoteca</p>
          <a href="/sobre-nosotros/">Quiénes somos</a>
          <a href="/metodologia/">Metodología</a>
          <a href="/politica-editorial/">Política editorial</a>
          <a href="/contacto/">Contacto</a>
        </div>
      </div>
      <div class="wrap disclaimer">
        <p>Revisión Hipoteca es un proyecto independiente: no es un banco, ni un intermediario de crédito, ni presta asesoramiento financiero. Los cálculos son orientativos; las condiciones de tu contrato y la liquidación de tu entidad son las que cuentan. Datos del euríbor: Banco de España, tipos de referencia oficiales del mercado hipotecario.</p>
      </div>
      <div class="wrap legal">
        <span>© {year} Revisión Hipoteca · Bernat Yeste Biosca</span>
        <span><a href="/aviso-legal/">Aviso legal</a> <a href="/privacidad/">Privacidad</a> <a href="/cookies/">Cookies</a></span>
      </div>
    </footer>
  </body>
</html>
<style is:global>
  :root {
    --paper: #ffffff; --mist: #f1f3f8; --canvas: #f4f6fa; --ink: #111833; --muted: #596079; --line: #e1e5ee;
    --accent: #2c46e8; --accent-ink: #1d33c4; --up: #c3283d; --up-bg: #fdecee; --down: #13804f; --down-bg: #e6f5ee; --coral: #ff5a5f;
    --font: 'Public Sans Variable', system-ui, sans-serif; --display: 'Bricolage Grotesque Variable', 'Public Sans Variable', sans-serif;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; font-family: var(--font); color: var(--ink); background: var(--paper); font-size: 16.5px; line-height: 1.65; -webkit-font-smoothing: antialiased; }
  .wrap { max-width: 1120px; margin: 0 auto; padding: 0 22px; }
  main.wrap { padding-top: 40px; padding-bottom: 72px; }
  h1, h2, h3 { font-family: var(--display); line-height: 1.12; letter-spacing: -0.015em; }
  h1 { font-size: clamp(2.1rem, 4.8vw, 3.4rem); font-weight: 780; margin: 0 0 16px; letter-spacing: -0.025em; }
  h2 { font-size: clamp(1.45rem, 2.4vw, 1.8rem); font-weight: 740; margin: 2.2em 0 0.6em; }
  h3 { font-size: 1.12rem; font-weight: 700; margin: 1.6em 0 0.4em; }
  p { margin: 0 0 1em; }
  a { color: var(--accent); text-underline-offset: 3px; }
  a:hover { color: var(--accent-ink); }
  :focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
  .muted { color: var(--muted); }
  .lead { font-size: 1.15rem; color: #2c3350; max-width: 68ch; }
  .prose { max-width: 70ch; }
  .prose li { margin-bottom: 0.4em; }
  .num, td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
  table { border-collapse: collapse; width: 100%; font-variant-numeric: tabular-nums; }
  th, td { padding: 9px 10px; border-bottom: 1px solid var(--line); text-align: left; }
  thead th { font-size: 0.82rem; color: var(--muted); font-weight: 600; border-bottom: 2px solid var(--line); }
  .table-scroll { overflow-x: auto; }
  .table-scroll table { min-width: 620px; }
  .table-scroll td, .table-scroll th { white-space: nowrap; }
  .table-scroll td:first-child { white-space: normal; }
  .up { color: var(--up); } .down { color: var(--down); }
  details { border-bottom: 1px solid var(--line); padding: 16px 0; max-width: 76ch; }
  details:first-of-type { border-top: 1px solid var(--line); }
  summary { cursor: pointer; font-weight: 650; list-style: none; display: flex; justify-content: space-between; gap: 16px; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; font-size: 1.3rem; line-height: 1; color: var(--muted); }
  details[open] summary::after { content: '−'; }
  details p { margin: 8px 0 0; }
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 12px; top: 12px; background: #fff; padding: 8px 12px; z-index: 10; }
  .linklist { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 10px; }
  .linklist a { display: block; padding: 14px 16px; border: 1px solid var(--line); border-radius: 12px; color: var(--ink); text-decoration: none; font-weight: 650; }
  .linklist a span { display: block; font-weight: 400; font-size: 0.92rem; color: var(--muted); }
  .linklist a:hover { border-color: var(--accent); }
  .btn { display: inline-block; background: var(--ink); color: #fff; border: 0; border-radius: 999px; padding: 11px 20px; font: inherit; font-weight: 650; text-decoration: none; cursor: pointer; }
  .btn:hover { background: #222a4d; color: #fff; }
  .field { display: grid; gap: 4px; }
  .field label { font-size: 0.84rem; font-weight: 600; color: #2c3350; }
  .inp { position: relative; display: flex; align-items: center; }
  .inp input { padding-right: 52px; }
  .inp span { position: absolute; right: 12px; color: var(--muted); font-size: 0.9rem; pointer-events: none; }
  .field .hint { font-size: 0.8rem; color: var(--muted); }
  input, select { font: inherit; font-size: 1rem; font-weight: 500; min-height: 48px; padding: 10px 12px; border: 1px solid #cdd3e0; border-radius: 12px; background: #fff; transition: border-color 0.15s, box-shadow 0.15s; color: var(--ink); width: 100%; font-variant-numeric: tabular-nums; }
  input:hover, select:hover { border-color: #aab2c6; }
  input:focus, select:focus { outline: none; box-shadow: 0 0 0 4px rgba(44, 70, 232, 0.16); border-color: var(--accent); }
  select { appearance: none; background-image: linear-gradient(45deg, transparent 50%, #596079 50%), linear-gradient(135deg, #596079 50%, transparent 50%); background-position: calc(100% - 18px) 21px, calc(100% - 13px) 21px; background-size: 5px 5px; background-repeat: no-repeat; padding-right: 34px; }
  .site-header { border-bottom: 1px solid var(--line); background: rgba(255,255,255,0.96); backdrop-filter: saturate(1.4) blur(6px); position: sticky; top: 0; z-index: 5; }
  .hbar { display: flex; align-items: center; justify-content: space-between; gap: 18px; min-height: 68px; }
  .brand { display: flex; align-items: center; gap: 10px; color: var(--ink); text-decoration: none; font-family: var(--display); font-size: 1.15rem; font-weight: 500; letter-spacing: -0.01em; }
  .brand b, .foot-brand b { font-weight: 800; }
  .site-header nav { display: flex; gap: 4px; overflow-x: auto; }
  .site-header nav a { color: var(--ink); text-decoration: none; padding: 7px 11px; border-radius: 8px; font-size: 0.95rem; white-space: nowrap; }
  .site-header nav a:hover { background: var(--mist); }
  .site-header nav a[aria-current='page'] { background: var(--mist); font-weight: 700; }
  .databar { background: var(--ink); color: #d6daea; font-size: 0.84rem; }
  .databar-in { display: flex; justify-content: space-between; gap: 6px 18px; flex-wrap: wrap; padding-top: 7px; padding-bottom: 7px; }
  .databar strong { color: #fff; font-variant-numeric: tabular-nums; }
  .databar a { color: #fff; }
  @media (max-width: 760px) { .databar-src { display: none; } }
  .live { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: #3ddc97; margin-right: 8px; vertical-align: 1px; }
  .disclaimer p { font-size: 0.82rem; color: #9aa1bd; max-width: 92ch; margin: 28px 0 0; }
  .foot-mail a { display: inline; }
  .site-footer { background: var(--ink); color: #c8cde0; padding: 48px 0 24px; font-size: 0.93rem; }
  .foot { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 28px; }
  .foot a { display: block; color: #fff; text-decoration: none; margin-bottom: 6px; }
  .foot a:hover { text-decoration: underline; color: #fff; }
  .foot-brand { color: #fff; font-family: var(--display); font-size: 1.2rem; margin-bottom: 6px; }
  .foot-title { color: #fff; font-weight: 700; margin-bottom: 8px; }
  .legal { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; border-top: 1px solid #2c3456; margin-top: 20px; padding-top: 18px; font-size: 0.84rem; }
  .legal a { color: #c8cde0; margin-left: 14px; }
  @media (max-width: 760px) {
    .hbar { flex-direction: column; align-items: flex-start; gap: 4px; padding-top: 10px; padding-bottom: 6px; }
    .site-header nav { width: 100%; margin: 0 -11px; }
    .site-header { position: static; }
    .foot { grid-template-columns: 1fr 1fr; }
    body { font-size: 16px; }
  }
  @media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } }
</style>
